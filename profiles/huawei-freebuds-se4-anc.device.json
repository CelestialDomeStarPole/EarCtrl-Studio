{
  "$schema": "https://earctrl.local/schemas/device-profile.schema.json",
  "schemaVersion": 1,
  "brand": "huawei",
  "agentExe": "EarCtrl.Agent.Huawei.exe",
  "pipeName": "earctrl.agent.huawei",
  "model": {
    "name": "HUAWEI FreeBuds SE 4 ANC",
    "deviceModel": "T0026",
    "caseModel": "T0026L",
    "firmwares": ["待实测补充（App 设备详情页截图）"]
  },
  "matchRules": {
    "namePrefixes": ["HUAWEI FreeBuds SE 4 ANC", "FreeBuds SE 4"],
    "manufacturerIds": [],
    "serviceUuids": [],
    "comment": "三级匹配优先级：serviceUuids > manufacturerIds > namePrefixes；M2 实测后填充厂商 ID 与 GATT 服务 UUID"
  },
  "pollWhenSilent": true,
  "capabilities": {
    "battery": { "left": true, "right": true, "case": true },
    "ancModes": ["normal", "cancellation", "awareness"],
    "ancLevels": ["comfort", "normal", "ultra", "dynamic"],
    "ancWindNoise": true,
    "equalizer": { "presets": ["default", "hardbass", "treble", "voices"], "custom": true },
    "lowLatency": true,
    "holdAction": {
      "left": true,
      "right": true,
      "options": ["off", "anc-cycle", "voice-assistant", "volume-up", "volume-down"],
      "inCallOptions": ["off", "reject-call"],
      "ancCycleOptions": [1, 2, 3, 4]
    },
    "doubleTap": {
      "left": true,
      "right": true,
      "options": ["off", "play-pause", "next", "prev", "voice-assistant"],
      "inCallOptions": ["off", "answer"]
    },
    "tripleTap": {
      "left": true,
      "right": true,
      "options": ["off", "next", "prev"]
    },
    "multiTap": {
      "left": true,
      "right": true,
      "options": ["off", "volume-up", "volume-down"]
    },
    "dualConnect": false,
    "findMy": false,
    "wearDetect": false,
    "ldac": false
  },
  "notes": "能力矩阵对照 OpenFreebuds docs/devices/HUAWEI_FreeBuds_SE_4.md 与华为官网规格；M1 逐命令实测后修订。"
}
