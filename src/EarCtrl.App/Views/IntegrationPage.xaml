<Page x:Class="EarCtrl.App.Views.IntegrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,16"
                          Text="{Binding [Nav.Integration], Source={x:Static services:LocSource.Instance}}" />

            <!-- 通知：低电量托盘气泡 -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Integration.Notifications], Source={x:Static services:LocSource.Instance}}" />
                    <ui:ToggleSwitch x:Name="LowBatteryToggle" Margin="0,12,0,0" HorizontalAlignment="Left"
                                     Click="OnLowBatteryToggled"
                                     Content="{Binding [Integration.LowBattery], Source={x:Static services:LocSource.Instance}}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Integration.Threshold], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="ThresholdCombo" Grid.Column="1" Width="120" MinHeight="34"
                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                  SelectionChanged="OnThresholdChanged" />
                    </Grid>
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Integration.LowBattery.Desc], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>

            <!-- Agent 管理（每设备一行，状态持久化到 config.DisabledAgents） -->
            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Integration.Agents], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Integration.Agents.Desc], Source={x:Static services:LocSource.Instance}}" />
                    <StackPanel x:Name="AgentPanel" Margin="0,12,0,0" />
                    <ui:TextBlock x:Name="NoAgentText" Margin="0,8,0,0" Visibility="Collapsed"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Integration.Agents.None], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
