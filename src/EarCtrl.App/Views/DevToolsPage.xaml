<Page x:Class="EarCtrl.App.Views.DevToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1000" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,4"
                          Text="{Binding [Nav.DevTools], Source={x:Static services:LocSource.Instance}}" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20">
                <Run Text="{Binding [Dashboard.CurrentDevice], Source={x:Static services:LocSource.Instance}, Mode=OneWay}" />
                <Run x:Name="CurrentDeviceRun" Text="--" FontWeight="SemiBold" />
            </ui:TextBlock>

            <!-- 原始帧日志 -->
            <ui:Card>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:ToggleSwitch x:Name="SubscribeToggle" Grid.Column="0" IsChecked="True"
                                         Click="OnSubscribeToggled"
                                         Content="{Binding [DevTools.Subscribe], Source={x:Static services:LocSource.Instance}}" />
                        <ui:Button Grid.Column="1" Click="OnClearClick"
                                   Content="{Binding [DevTools.Clear], Source={x:Static services:LocSource.Instance}}" />
                    </Grid>
                    <TextBox x:Name="LogBox" Margin="0,12,0,0" Height="320" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>

            <!-- 发送原始帧 -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [DevTools.RawHex], Source={x:Static services:LocSource.Instance}}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RawHexBox" Grid.Column="0" MinHeight="34" FontFamily="Consolas"
                                 VerticalContentAlignment="Center" Text="5A0009000108010002000300FBB9" />
                        <ui:Button x:Name="SendButton" Grid.Column="1" Margin="8,0,0,0" Appearance="Primary"
                                   Click="OnSendClick"
                                   Content="{Binding [DevTools.Send], Source={x:Static services:LocSource.Instance}}" />
                    </Grid>
                    <ui:TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [DevTools.SendHint], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock x:Name="HintText" Margin="0,16,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
