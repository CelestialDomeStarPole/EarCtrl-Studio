<Page x:Class="EarCtrl.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services"
      DataContext="{Binding Source={x:Static services:SettingsViewModel.Instance}}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Text="{Binding [Nav.Settings], Source={x:Static services:LocSource.Instance}}" Margin="0,0,0,16" />

            <!-- 外观卡片：主题 + 语言（M0 验收：两处切换立即生效） -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding [Settings.Appearance], Source={x:Static services:LocSource.Instance}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Settings.Theme], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox Grid.Column="1" Width="160" MinHeight="34"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedValue="{Binding SelectedTheme}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Settings.Language], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox Grid.Column="1" Width="160" MinHeight="34"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedValue="{Binding SelectedLanguage}"
                                  SelectedValuePath="Code" DisplayMemberPath="DisplayName" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 状态轮询卡片：轮询驱动在仓/佩戴检测；电量靠耳机事件推送不依赖轮询 -->
            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding [Settings.PollInterval], Source={x:Static services:LocSource.Instance}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Settings.PollInterval], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox Grid.Column="1" Width="160" MinHeight="34"
                                  ItemsSource="{Binding PollOptions}"
                                  SelectedValue="{Binding SelectedPollIntervalSec}"
                                  SelectedValuePath="Key" DisplayMemberPath="Value" />
                    </Grid>

                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Settings.PollInterval.Hint], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
