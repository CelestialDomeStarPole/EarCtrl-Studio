<Page x:Class="EarCtrl.App.Views.AncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,4"
                          Text="{Binding [Nav.Anc], Source={x:Static services:LocSource.Instance}}" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20">
                <Run Text="{Binding [Dashboard.CurrentDevice], Source={x:Static services:LocSource.Instance}, Mode=OneWay}" />
                <Run x:Name="CurrentDeviceRun" Text="--" FontWeight="SemiBold" />
            </ui:TextBlock>

            <!-- 五态大号分段（K11）：深度 / 均衡 / 轻度 / 透传 / 关闭 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BtnUltra" Grid.Column="0" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnStateClick" Tag="Ultra"
                           Content="{Binding [Anc.Ultra], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnGeneral" Grid.Column="1" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnStateClick" Tag="General"
                           Content="{Binding [Anc.General], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnCozy" Grid.Column="2" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnStateClick" Tag="Cozy"
                           Content="{Binding [Anc.Cozy], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnTransparency" Grid.Column="3" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnStateClick" Tag="Transparency"
                           Content="{Binding [Anc.Transparency], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnOff" Grid.Column="4" Height="64" FontSize="15"
                           Appearance="Secondary" Click="OnStateClick" Tag="Off"
                           Content="{Binding [Anc.Off], Source={x:Static services:LocSource.Instance}}" />
            </Grid>

            <ui:TextBlock x:Name="HintText" Margin="0,16,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding [Anc.NotReady], Source={x:Static services:LocSource.Instance}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
