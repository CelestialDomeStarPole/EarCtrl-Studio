<Page x:Class="EarCtrl.App.Views.AncPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,4"
                          Text="{Binding [Nav.Anc], Source={x:Static services:LocSource.Instance}}" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20">
                <Run Text="{Binding [Dashboard.CurrentDevice], Source={x:Static services:LocSource.Instance}, Mode=OneWay}" />
                <Run x:Name="CurrentDeviceRun" Text="--" FontWeight="SemiBold" />
            </ui:TextBlock>

            <!-- 模式三选（K11）：降噪 / 透传 / 关闭 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BtnCancellation" Grid.Column="0" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnModeClick" Tag="cancellation"
                           Content="{Binding [Anc.Cancellation], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnAwareness" Grid.Column="1" Height="64" Margin="0,0,8,0" FontSize="15"
                           Appearance="Secondary" Click="OnModeClick" Tag="awareness"
                           Content="{Binding [Anc.Awareness], Source={x:Static services:LocSource.Instance}}" />
                <ui:Button x:Name="BtnOff" Grid.Column="2" Height="64" FontSize="15"
                           Appearance="Secondary" Click="OnModeClick" Tag="normal"
                           Content="{Binding [Anc.Off], Source={x:Static services:LocSource.Instance}}" />
            </Grid>

            <!-- 降噪等级：常驻显示，仅「降噪」模式可选（未选中时虚化禁用）；动态项按 Profile 能力显示 -->
            <Grid x:Name="LevelPanel" Margin="0,16,0,0" Opacity="0.4" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                              Text="{Binding [Anc.Level], Source={x:Static services:LocSource.Instance}}" />
                <ComboBox x:Name="LevelCombo" Grid.Column="1" Width="160" MinHeight="34"
                          SelectedValuePath="Key" DisplayMemberPath="Value"
                          SelectionChanged="OnLevelChanged" />
            </Grid>

            <!-- 防风噪：仅降噪模式显示（动态档虚化必开，其余档位独立记忆），策略逻辑在 AgentHost -->
            <Grid x:Name="WindNoisePanel" Margin="0,16,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                              Text="{Binding [Anc.WindNoise], Source={x:Static services:LocSource.Instance}}" />
                <ui:ToggleSwitch x:Name="WindNoiseToggle" Grid.Column="1" Click="OnWindNoiseToggled" />
            </Grid>

            <ui:TextBlock x:Name="HintText" Margin="0,16,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding [Anc.NotReady], Source={x:Static services:LocSource.Instance}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
