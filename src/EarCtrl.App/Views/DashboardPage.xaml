<Page x:Class="EarCtrl.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <!-- 设备状态大卡片（M3 实现电量与五态控件；当前为占位） -->
            <ui:Card>
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle" Text="{Binding [Nav.Dashboard], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Dashboard.Placeholder], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
