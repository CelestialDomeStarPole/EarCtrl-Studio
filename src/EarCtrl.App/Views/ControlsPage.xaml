<Page x:Class="EarCtrl.App.Views.ControlsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,4"
                          Text="{Binding [Nav.Controls], Source={x:Static services:LocSource.Instance}}" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20">
                <Run Text="{Binding [Dashboard.CurrentDevice], Source={x:Static services:LocSource.Instance}, Mode=OneWay}" />
                <Run x:Name="CurrentDeviceRun" Text="--" FontWeight="SemiBold" />
            </ui:TextBlock>

            <!-- 长按动作（module: controls.holdAction.left/right/inCall） -->
            <ui:Card x:Name="ActionCard" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Controls.HoldAction], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Controls.HoldAction.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid x:Name="LeftActionRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Left], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="LeftActionCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="RightActionRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Right], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="RightActionCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="InCallRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.InCall], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="InCallCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 双击（module: controls.doubleTap.left/right/inCall） -->
            <ui:Card x:Name="DoubleTapCard" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Controls.DoubleTap], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Controls.DoubleTap.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid x:Name="DoubleLeftRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Left], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="DoubleLeftCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="DoubleRightRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Right], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="DoubleRightCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="DoubleInCallRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.InCall], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="DoubleInCallCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 三击（module: controls.tripleTap.left/right） -->
            <ui:Card x:Name="TripleTapCard" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Controls.TripleTap], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Controls.TripleTap.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid x:Name="TripleLeftRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Left], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="TripleLeftCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="TripleRightRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Right], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="TripleRightCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 连击（五下）（module: controls.multiTap.left/right） -->
            <ui:Card x:Name="MultiTapCard" Margin="0,0,0,12">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Controls.MultiTap], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Controls.MultiTap.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid x:Name="MultiLeftRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Left], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="MultiLeftCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>

                    <Grid x:Name="MultiRightRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.Right], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="MultiRightCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- 长按切换降噪的循环模式（module: controls.ancCycle.left）：固件左右联动，只显示一行 -->
            <ui:Card x:Name="AncCycleCard">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Controls.AncCycle], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Controls.AncCycle.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid x:Name="CycleRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" VerticalAlignment="Center"
                                      Text="{Binding [Controls.AncCycle.Mode], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="CycleCombo" Grid.Column="1" Width="220" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnGestureChanged" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:TextBlock x:Name="HintText" Margin="0,16,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
