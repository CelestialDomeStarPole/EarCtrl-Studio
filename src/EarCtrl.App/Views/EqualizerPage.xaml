<Page x:Class="EarCtrl.App.Views.EqualizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:services="clr-namespace:EarCtrl.App.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="860" HorizontalAlignment="Left">
            <ui:TextBlock FontTypography="Title" Margin="0,0,0,4"
                          Text="{Binding [Nav.Equalizer], Source={x:Static services:LocSource.Instance}}" />
            <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20">
                <Run Text="{Binding [Dashboard.CurrentDevice], Source={x:Static services:LocSource.Instance}, Mode=OneWay}" />
                <Run x:Name="CurrentDeviceRun" Text="--" FontWeight="SemiBold" />
            </ui:TextBlock>

            <!-- 预设（module: equalizer.presets；列表来自 Profile 能力，按钮由代码生成） -->
            <ui:Card x:Name="PresetCard">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Eq.Presets], Source={x:Static services:LocSource.Instance}}" />
                    <WrapPanel x:Name="PresetPanel" Margin="0,12,0,0" />
                </StackPanel>
            </ui:Card>

            <!-- 自定义音效（module: equalizer.custom）：10 段滑块，保存后立即应用到耳机 -->
            <ui:Card x:Name="CustomCard" Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock FontTypography="Subtitle"
                                  Text="{Binding [Eq.Custom], Source={x:Static services:LocSource.Instance}}" />
                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Eq.Custom.Desc], Source={x:Static services:LocSource.Instance}}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="CustomNameBox" Grid.Column="0" MinHeight="34" Margin="0,0,8,0"
                                    VerticalContentAlignment="Center"
                                    PlaceholderText="{Binding [Eq.Custom.NameHint], Source={x:Static services:LocSource.Instance}}" />
                        <ComboBox x:Name="CustomModeCombo" Grid.Column="1" Width="180" MinHeight="34"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  SelectionChanged="OnCustomModeChanged" />
                    </Grid>

                    <UniformGrid x:Name="BandPanel" Columns="10" Margin="0,16,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button Click="OnResetCustomClick"
                                   Content="{Binding [Eq.Custom.Reset], Source={x:Static services:LocSource.Instance}}" />
                        <ui:Button x:Name="ApplyCustomButton" Margin="8,0,0,0" Click="OnApplyCustomClick"
                                   Content="{Binding [Eq.Custom.Apply], Source={x:Static services:LocSource.Instance}}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Click="OnSaveCustomClick"
                                   Content="{Binding [Eq.Custom.Save], Source={x:Static services:LocSource.Instance}}" />
                    </StackPanel>

                    <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding [Eq.Custom.BandHint], Source={x:Static services:LocSource.Instance}}" />
                </StackPanel>
            </ui:Card>

            <ui:TextBlock x:Name="HintText" Margin="0,16,0,0" Visibility="Collapsed"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
