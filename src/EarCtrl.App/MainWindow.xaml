<ui:FluentWindow x:Class="EarCtrl.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:services="clr-namespace:EarCtrl.App.Services"
                 xmlns:pages="clr-namespace:EarCtrl.App.Views"
                 Title="EarCtrl Studio"
                 Width="1080" Height="720"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="EarCtrl Studio" />

        <ui:NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed"
                           PaneDisplayMode="Left" OpenPaneLength="220" IsPaneOpen="True">
            <ui:NavigationView.MenuItems>
                <!-- 我的耳机 = 可展开的设备集合（K10）：蓝条用内置选中态（显示设备主页时 IsActive），子项为各设备 -->
                <ui:NavigationViewItem x:Name="MyDevicesItem" Tag="my-devices" Icon="{ui:SymbolIcon SurfaceEarbuds24}"
                                       Content="{Binding [Nav.Dashboard], Source={x:Static services:LocSource.Instance}}" />
                <ui:NavigationViewItem Tag="Anc" Icon="{ui:SymbolIcon HeadphonesSoundWave24}" TargetPageType="{x:Type pages:AncPage}"
                                       Content="{Binding [Nav.Anc], Source={x:Static services:LocSource.Instance}}" />
                <ui:NavigationViewItem Tag="Equalizer" Icon="{ui:SymbolIcon Options24}" TargetPageType="{x:Type pages:EqualizerPlaceholder}"
                                       Content="{Binding [Nav.Equalizer], Source={x:Static services:LocSource.Instance}}" />
                <ui:NavigationViewItem Tag="Controls" Icon="{ui:SymbolIcon TapDouble24}" TargetPageType="{x:Type pages:ControlsPlaceholder}"
                                       Content="{Binding [Nav.Controls], Source={x:Static services:LocSource.Instance}}" />
                <ui:NavigationViewItem Tag="Integration" Icon="{ui:SymbolIcon PuzzlePiece24}" TargetPageType="{x:Type pages:IntegrationPlaceholder}"
                                       Content="{Binding [Nav.Integration], Source={x:Static services:LocSource.Instance}}" />
                <ui:NavigationViewItem Tag="Advanced" Icon="{ui:SymbolIcon Beaker24}" TargetPageType="{x:Type pages:AdvancedPlaceholder}"
                                       Content="{Binding [Nav.Advanced], Source={x:Static services:LocSource.Instance}}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Tag="DevTools" Icon="{ui:SymbolIcon Bug24}" TargetPageType="{x:Type pages:DevToolsPlaceholder}"
                                       Content="{Binding [Nav.DevTools], Source={x:Static services:LocSource.Instance}}"
                                       Visibility="{Binding DevToolsVisibility, Source={x:Static services:UiState.Instance}}" />
                <ui:NavigationViewItem Tag="Settings" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}"
                                       Content="{Binding [Nav.Settings], Source={x:Static services:LocSource.Instance}}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
